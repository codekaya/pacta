# Trustless Work — dapp.trustlesswork.com → Settings → API Keys (testnet)
TW_API_KEY=
# Defaults to https://dev.api.trustlesswork.com
TW_API_URL=

# Pacta Policy Commitment Contract (written by `npm run deploy:policy`)
PACTA_POLICY_CONTRACT=

# Demo signing keys. Locally these come from web/.tw-wallets.json; on a host,
# paste that file's contents here as one line. TESTNET KEYS ONLY.
PACTA_WALLETS=

# Shared state across serverless instances (Upstash Redis or Vercel KV).
# Without these the deal state lives in memory, which breaks on Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Clinic payout IBAN for the anchor withdrawal (optional; sandbox default otherwise)
CLINIC_IBAN=
